NODE_ENV=development
PORT=8080
ONLINE_DATABASE_URL=mongodb://127.0.0.1:27017/rwdrj
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
MONGO_MAX_POOL_SIZE=10
CLOUDINARY_API_CLIENT_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Account emails (forgot password, password changed, invitations).
# Gmail: the account address + an App Password (Google Account > Security > App passwords).
RESET_PASSWORD_EMAIL=
RESET_PASSWORD_PASSWORD=
# Or any SMTP provider (takes precedence when SMTP_HOST is set):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. RWDRJ <no-reply@womenrepro.org>
MAIL_FROM=
# Public site URL used in email links (falls back to FRONTEND_URL / frontendURL)
APP_URL=

# --- Managed content (Firebase) ---
# Service account for firebase-admin: either the whole JSON (raw or base64)...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or the three fields separately (escape newlines in the key as \n)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
# Local development against the emulator (npm run emulators); leave empty in production
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_DATABASE_EMULATOR_HOST=

# --- Uploads ---
# cloudinary (default when CLOUDINARY_API_KEY is set) or local (dev/tests: files in server/uploads)
UPLOAD_DRIVER=
# Public base URL used for local upload links, e.g. http://localhost:8080
PUBLIC_SERVER_URL=
LOGIN_RATE_LIMIT=30

